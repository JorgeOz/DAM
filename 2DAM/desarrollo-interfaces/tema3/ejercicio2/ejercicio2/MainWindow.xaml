<Fluent:RibbonWindow x:Class="ejercicio2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Fluent="urn:fluent-ribbon"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ejercicio2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
        <!-- Atributos para ocultar la barra superior: ShowCloseButton="False" ShowMaxRestoreButton="False" ShowMinButton="False" ShowTitleBar="False" -->
    <Grid>
        <Fluent:Ribbon>
            <Fluent:Ribbon.Menu>
                <Fluent:Backstage Header="Archivo">
                    <Fluent:BackstageTabControl>
                        <Fluent:BackstageTabItem Header="Opciones"/>
                        <Fluent:Button Header="Salir" Click="Salir_Click"/>
                    </Fluent:BackstageTabControl>
                </Fluent:Backstage>
            </Fluent:Ribbon.Menu>

            <Fluent:RibbonTabItem Header="PRÉSTAMOS">
                <Fluent:RibbonGroupBox Header="Operaciones">
                    <Fluent:Button Header="Salida" Icon="Iconos/salida.png"/>
                    <Fluent:Button Header="Devolución" Icon="Iconos/devolucion.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Búsquedas">
                    <TextBlock Text="Por número de serie" FontWeight="Bold"/>
                    <Fluent:TextBox/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Listados">
                    <Fluent:Button Icon="Iconos/listamodelos.png"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="ARTÍCULOS">
                <Fluent:RibbonGroupBox Header="Artículos">
                    <Fluent:Button Header="Nuevo" Icon="Iconos/addarticulo.png"/>
                    <Fluent:Button Header="Editar" Icon="Iconos/gesarticulo.png"/>
                    <Fluent:Button Header="Listado" Icon="Iconos/listaarticulos.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Modelo Artículo">
                    <Fluent:Button Header="Nuevo" Icon="Iconos/iconmodelo.png"/>
                    <Fluent:Button Header="Editar" Icon="Iconos/editar.png"/>
                    <Fluent:Button Header="Listado" Icon="Iconos/listaarticulos.png"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="ADMINISTRACIÓN">
                <Fluent:RibbonGroupBox Header="Gestión Usuarios">
                    <Fluent:Button Header="Nuevo" Icon="Iconos/addarticulo.png"/>
                    <Fluent:Button Header="Editar" Icon="Iconos/gesarticulo.png"/>
                    <Fluent:Button Header="Contraseñas" Icon="Iconos/listaarticulos.png"/>
                    <Fluent:Button Header="Listado" Icon="Iconos/listaarticulos.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="Mantenimiento">
                    <Fluent:Button Header="NueArtículo" Icon="Iconos/iconmodelo.png"/>
                    <Fluent:Button Header="Modelo" Icon="Iconos/editar.png"/>
                    <Fluent:Button Header="usuario" Icon="Iconos/listaarticulos.png"/>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="STOCK">
                    <Fluent:Button Icon="Iconos/iconmodelo.png"/>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>
    </Grid>
</Fluent:RibbonWindow>
