<mah:MetroWindow x:Class="ejercicio4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:ejercicio4"
        mc:Ignorable="d"
        Title="Inventario Matisse" Height="650" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">
        <!-- Atributos para ocultar la barra superior: ShowCloseButton="False" ShowMaxRestoreButton="False" ShowMinButton="False" ShowTitleBar="False" -->

    <mah:HamburgerMenu DisplayMode="CompactInline" IsPaneOpen="False"
                       CompactPaneLength="50" OpenPaneLength="220"
                       HamburgerWidth="50" HamburgerHeight="50">

        <mah:HamburgerMenu.ItemsSource>
            <mah:HamburgerMenuItemCollection>
                <mah:HamburgerMenuIconItem Label="Préstamos">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Cylinder" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>

                <mah:HamburgerMenuIconItem Label="Búsquedas">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="SearchWeb" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>

                <mah:HamburgerMenuIconItem Label="Artículos">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Boombox" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>

                <mah:HamburgerMenuIconItem Label="Administración">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Tools" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>

                <mah:HamburgerMenuIconItem Label="Inventario">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="ListBox" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>

                <mah:HamburgerMenuIconItem Label="Información">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Information" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>
                
            </mah:HamburgerMenuItemCollection>
        </mah:HamburgerMenu.ItemsSource>

        <!--  Elementos que se anclan abajo -->
        <mah:HamburgerMenu.OptionsItemsSource>
            <mah:HamburgerMenuItemCollection>
                <mah:HamburgerMenuIconItem Label="Ayuda">
                    <mah:HamburgerMenuIconItem.Icon>
                        <iconPacks:PackIconMaterial Kind="Help" Width="24" Height="24" />
                    </mah:HamburgerMenuIconItem.Icon>
                </mah:HamburgerMenuIconItem>
            </mah:HamburgerMenuItemCollection>
        </mah:HamburgerMenu.OptionsItemsSource>

        <mah:HamburgerMenu.ItemTemplate>
            <DataTemplate DataType="{x:Type mah:HamburgerMenuIconItem}">
                <Grid Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" Content="{Binding Icon}"
                            Foreground="White" Focusable="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                       VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                </Grid>
            </DataTemplate>
        </mah:HamburgerMenu.ItemTemplate>

        <!-- Mismo template -->
        <mah:HamburgerMenu.OptionsItemTemplate>
            <DataTemplate DataType="{x:Type mah:HamburgerMenuIconItem}">
                <Grid Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" Content="{Binding Icon}"
                                Foreground="White" Focusable="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                           VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                </Grid>
            </DataTemplate>
        </mah:HamburgerMenu.OptionsItemTemplate>
    </mah:HamburgerMenu>
</mah:MetroWindow>
