<mah:MetroWindow x:Class="ejercicio1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ejercicio1"
        mc:Ignorable="d"
        Title="Ejercicio 1 - Inventario Matisse" Height="450" Width="800"
        Icon="/recursos/matisse.png"
        WindowStartupLocation="CenterScreen">
        <!-- Atributos para ocultar la barra superior: ShowCloseButton="False" ShowMaxRestoreButton="False" ShowMinButton="False" ShowTitleBar="False" -->
    
    <!-- DockPanel: menú y barra arriba, el resto es la zona central -->
    <DockPanel>

        <!-- ===================== BARRA DE MENÚ ===================== -->
        <!-- El guion bajo "_" delante de una letra crea el acceso rápido con Alt -->
        <Menu DockPanel.Dock="Top" IsMainMenu="True">

            <!-- PRÉSTAMOS -->
            <MenuItem Header="_Prestamos">
                <MenuItem Header="Salidas">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Logout" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Entradas">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Login" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Listado Pendientes">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="ClipboardText" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- ARTÍCULOS -->
            <MenuItem Header="_Articulos">
                <MenuItem Header="Articulo Nuevo">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="PlusBox" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Editar">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Pencil" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lista">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="FormatListBulleted" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Modelo Articulo Nuevo">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="PlusBox" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Modelo Articulo Editar">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Pencil" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lista Modelo Articulo">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="ViewList" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- ADMINISTRACIÓN (con submenús anidados: MenuItem dentro de MenuItem) -->
            <MenuItem Header="_Administración">
                <MenuItem Header="Gestión Usuarios">
                    <MenuItem Header="Nuevo">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="AccountPlus" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Editar">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="AccountEdit" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Lista">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="FormatListBulleted" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Contraseñas">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Key" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mantenimiento">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="Wrench" />
                    </MenuItem.Icon>
                    <MenuItem Header="Eliminar Articulo">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="Delete" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Eliminar Modelo Articulo">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="DeleteForever" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Eliminar Usuario">
                        <MenuItem.Icon>
                            <material:PackIcon Kind="AccountRemove" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Stock">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="PackageVariant" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Listado Usuarios">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="AccountMultiple" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- INVENTARIO -->
            <MenuItem Header="_Inventario">
                <MenuItem Header="Listado de espacios">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="OfficeBuilding" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Chequear Inventario">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="CalendarCheck" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Inventario Nuevo">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="PlaylistPlus" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- INFORMACIÓN -->
            <MenuItem Header="I_nformación">
                <MenuItem Header="Informes">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="FileDocument" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Gráficos">
                    <MenuItem.Icon>
                        <material:PackIcon Kind="ChartLine" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ================= BARRA DE HERRAMIENTAS ================= -->
        <ToolBar DockPanel.Dock="Top">
            <!-- Cada botón lleva su ToolTip explicando la función -->
            <!-- Botón SALIR: su Click llama a Application.Current.Shutdown() (ver MainWindow.xaml.cs) -->
            <Button ToolTip="Salir de la aplicación" Click="Salir_Click">
                <material:PackIcon Kind="Logout" Width="20" Height="20" />
            </Button>
            <Button ToolTip="Registrar una entrada de material">
                <material:PackIcon Kind="Login" Width="20" Height="20" />
            </Button>
            <Button ToolTip="Guardar cambios">
                <material:PackIcon Kind="ContentSave" Width="20" Height="20" />
            </Button>
            <Button ToolTip="Ver el listado de artículos">
                <material:PackIcon Kind="FormatListBulleted" Width="20" Height="20" />
            </Button>

            <Separator />

            <!-- Se pueden meter otros controles en la barra, no solo botones -->
            <Label Content="Busca un artículo" VerticalAlignment="Center" />
            <TextBox Width="150" VerticalAlignment="Center"
                     ToolTip="Escribe el nombre del artículo que quieres buscar" />
        </ToolBar>

        <!-- Zona central: aquí se irán mostrando las pantallas de la aplicación.
             Al ser el último hijo del DockPanel (LastChildFill) ocupa todo el espacio restante -->
        <Grid x:Name="gridCentral" />

    </DockPanel>
</mah:MetroWindow>
