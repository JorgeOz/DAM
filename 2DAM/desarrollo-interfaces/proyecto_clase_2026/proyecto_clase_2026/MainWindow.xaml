<mah:MetroWindow x:Class="proyecto_clase_2026.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
                  Title="INVENTARIO MATISSE"
                  Height="450" Width="800"
                  Icon="/Recursos/Iconos/matisse.png"
                  WindowTitleBrush="#C41E0E"
                  NonActiveWindowTitleBrush="#C41E0E">

    <mah:MetroWindow.Resources>

        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#323232" />
        <SolidColorBrush x:Key="MenuForegroundBrush" Color="White" />

        <Style x:Key="MenuIconStyle" TargetType="mat:PackIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="10 16" />
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
        </Style>

        <Style x:Key="MenuExpanderStyle" TargetType="Expander"
               BasedOn="{StaticResource MaterialDesignExpander}">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Width" Value="210" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
        </Style>

        <Style x:Key="MenuListViewStyle" TargetType="ListView"
               BasedOn="{StaticResource MaterialDesignListView}">
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="PopupRowStyle" TargetType="Grid">
            <Setter Property="Width" Value="150" />
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="37 14" />
            <Setter Property="FontSize" Value="15" />
        </Style>

    </mah:MetroWindow.Resources>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <mat:PopupBox>
                <ListBox>
                    <ListBoxItem>
                        <Grid Style="{StaticResource PopupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ajustes" />
                            <mat:PackIcon Grid.Column="1" Kind="HammerScrewdriver" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem>
                        <Grid Style="{StaticResource PopupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cuenta" />
                            <mat:PackIcon Grid.Column="1" Kind="Account" />
                        </Grid>
                    </ListBoxItem>

                    <ListBoxItem>
                        <Grid Style="{StaticResource PopupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ayuda" />
                            <mat:PackIcon Grid.Column="1" Kind="Help" />
                        </Grid>
                    </ListBoxItem>

                    <Separator />

                    <ListBoxItem>
                        <Grid Style="{StaticResource PopupRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desconectar" />
                            <mat:PackIcon Grid.Column="1" Kind="Power" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </mat:PopupBox>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <DockPanel>

        <Grid DockPanel.Dock="Left" Width="250"
              Background="{StaticResource MenuBackgroundBrush}">

            <StackPanel x:Name="Menu" Margin="10">

                <Grid>
                    <mat:PackIcon Kind="ViewDashboard" Style="{StaticResource MenuIconStyle}" />
                    <ListBoxItem Content="DAM MATISSE" Padding="37 14" FontSize="15"
                                 Foreground="{StaticResource MenuForegroundBrush}"
                                 Style="{StaticResource MaterialDesignListBoxItem}" />
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="FileRefresh" Style="{StaticResource MenuIconStyle}" />
                    <Expander x:Name="expPrestamos" Header="Préstamos"
                              Style="{StaticResource MenuExpanderStyle}">
                        <ListView Style="{StaticResource MenuListViewStyle}">
                            <ListViewItem Content="Salidas"            Padding="20 5" />
                            <ListViewItem Content="Entradas"           Padding="20 5" />
                            <ListViewItem Content="Búsqueda"           Padding="20 5" />
                            <ListViewItem Content="Listado pendientes" Padding="20 5" />
                        </ListView>
                    </Expander>
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="Archive" Style="{StaticResource MenuIconStyle}" />
                    <Expander x:Name="expArticulos" Header="Artículos"
                              Style="{StaticResource MenuExpanderStyle}">
                        <ListView Style="{StaticResource MenuListViewStyle}">
                            <ListViewItem Content="Artículos"         Padding="20 5" />
                            <ListViewItem Content="Modelo Artículo"   Padding="20 5" />
                            <ListViewItem Content="Tipo de Artículos" Padding="20 5" />
                        </ListView>
                    </Expander>
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="Cog" Style="{StaticResource MenuIconStyle}" />
                    <Expander x:Name="expAdmin" Header="Administración"
                              Style="{StaticResource MenuExpanderStyle}">
                        <ListView Style="{StaticResource MenuListViewStyle}">
                            <ListViewItem Content="Gestión Usuarios" Padding="20 5" />
                            <ListViewItem Content="Contraseñas"      Padding="20 5" />
                            <ListViewItem Content="Mantenimiento"    Padding="20 5" />
                            <ListViewItem Content="Stock"            Padding="20 5" />
                            <ListViewItem Content="Listados"         Padding="20 5" />
                        </ListView>
                    </Expander>
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="ClipboardList" Style="{StaticResource MenuIconStyle}" />
                    <Expander x:Name="expInventario" Header="Inventario"
                              Style="{StaticResource MenuExpanderStyle}">
                        <ListView Style="{StaticResource MenuListViewStyle}">
                            <ListViewItem Content="Listado de Espacios" Padding="20 5" />
                            <ListViewItem Content="Chequear Inventario" Padding="20 5" />
                            <ListViewItem Content="Inventario Nuevo"    Padding="20 5" />
                        </ListView>
                    </Expander>
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="AlertCircle" Style="{StaticResource MenuIconStyle}" />
                    <Expander x:Name="expInfo" Header="Información"
                              Style="{StaticResource MenuExpanderStyle}">
                        <ListView Style="{StaticResource MenuListViewStyle}">
                            <ListViewItem Content="Informes" Padding="20 5" />
                            <ListViewItem Content="Gráficos" Padding="20 5" />
                        </ListView>
                    </Expander>
                </Grid>

                <Grid>
                    <mat:PackIcon Kind="Logout" Style="{StaticResource MenuIconStyle}" />
                    <Button x:Name="btnCerrarSesion"
                            Content="Cerrar sesión"
                            Click="btnCerrarSesion_Click"
                            Style="{StaticResource MenuButtonStyle}" />
                </Grid>

            </StackPanel>
        </Grid>

        <Grid x:Name="gridCentral" />

    </DockPanel>
</mah:MetroWindow>