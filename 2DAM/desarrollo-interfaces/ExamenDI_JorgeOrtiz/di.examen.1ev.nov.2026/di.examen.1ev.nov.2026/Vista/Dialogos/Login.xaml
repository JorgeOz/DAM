<Window x:Class="di.examen._1ev.nov._2026.Vista.Dialogos.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.examen._1ev.nov._2026.Vista.Dialogos"
        mc:Ignorable="d"
        Title="Login"
        Height="650"
        Width="1200"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#f3f3f3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Recursos/Iconos/matisse.png" VerticalAlignment="Top" Width="60" Margin="50, 40, 0, 0"/>
                    <Image Source="/Recursos/Iconos/grid.png" Width="90" VerticalAlignment="Top" Margin="180, 40, 0, 0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="90, 0, 0, 0">
                    <TextBlock Text="Simple Login" TextAlignment="Center" FontSize="36"/>
                    <TextBlock Text="IES HENRI MATISSE" TextAlignment="Center" FontSize="28" Foreground="#017dca" FontWeight="Bold" Margin="0, 5, 0, 0"/>
                    <TextBlock Text="Desarrollo de Interfaces" TextAlignment="Center" FontSize="20" FontWeight="DemiBold" Margin="0, 5, 0, 0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Image Source="/Recursos/Iconos/grid.png" Width="90" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50, 0, 0, 0"/>
            </Grid>
        </Grid>

   
        <Grid Grid.Column="1">
            <Rectangle Width="750" Height="550" RadiusX="20" RadiusY="20" Fill="#69c2fa" Margin="70, 0, 0, 0"/>
            <Grid Width="700" Height="500" Background="White" Margin="30, 0, 0, 0" Panel.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Source="/Recursos/Imagenes/login.jpg" Stretch="UniformToFill"/>
                    <Border Panel.ZIndex="10" Background="#80FFFFFF" Width="170" Height="40" VerticalAlignment="Bottom" Margin="0, 0, 0, 40" 
                            BorderBrush="Transparent" CornerRadius="20, 0, 20, 0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bienvenido a la clase" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#90000000"/>
                            <TextBlock Text="Inicio de sesión" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#90000000"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="240">
                        <TextBlock Text="Inicia sesión!" FontSize="36" TextAlignment="Left"/>
                        <TextBox x:Name="txtUsername" Margin="0, 30 0, 0">
                            <mat:HintAssist.Hint>
                                <StackPanel Orientation="Horizontal">
                                    <mat:PackIcon Kind="Account"/>
                                    <TextBlock Text="Usuario" Margin="10, 0, 0, 0"/>
                                </StackPanel>
                            </mat:HintAssist.Hint>
                        </TextBox>
                        
                        <PasswordBox x:Name="passClaveAcceso" Margin="0, 20 0, 0">
                            <mat:HintAssist.Hint>
                                <StackPanel Orientation="Horizontal">
                                    <mat:PackIcon Kind="Account"/>
                                    <TextBlock Text="Clave de acceso" Margin="10, 0, 0, 0"/>
                                </StackPanel>
                            </mat:HintAssist.Hint>
                        </PasswordBox>

                        <Button Content="Olvidaste la Contraseña" FontSize="12" HorizontalAlignment="Right" BorderBrush="Transparent" 
                                Background="Transparent" Margin="0, 20, 0, 0" Foreground="#017dca" FontWeight="Bold"/>

                        <Button Content="Continua" x:Name="btnLogin" Click="btnLogin_Click" Foreground="White" BorderBrush="Transparent" Margin="0, 15, 0, 0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#016fff" Offset="0.0"/>
                                    <GradientStop Color="#017dca" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <TextBlock Text="Inica con:" FontSize="12" HorizontalAlignment="Center" Margin="0, 25, 0, 0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0, 10, 0, 0">
                            <Button Background="Transparent" BorderBrush="Transparent" Width="50">
                                <mat:PackIcon Kind="Facebook"/>
                            </Button>

                            <Button Background="Transparent" BorderBrush="Transparent" Width="50">
                                <mat:PackIcon Kind="Google"/>
                            </Button>

                            <Button Background="Transparent" BorderBrush="Transparent" Width="50">
                                <mat:PackIcon Kind="Apple"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0">
                            <TextBlock Text="¿No tienes cuenta?" FontSize="12" Margin="10, 0, 0, 0" VerticalAlignment="Center"/>
                            <Button Content="Regístrate" FontSize="12" HorizontalAlignment="Right" BorderBrush="Transparent" 
                                Background="Transparent" Foreground="#017dca" FontWeight="Bold" Margin="30, 0, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
