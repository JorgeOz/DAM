<!-- EJERCICIO 2: LOGIN OSCURO (MetroWindow, tema Dark e Indigo configurado en App.xaml) -->
<!-- PLAN: ventana = Grid de 2 columnas, izquierda imagen y derecha StackPanel centrado verticalmente -->
<!-- Dentro del StackPanel: titulo, texto, boton Google, separador OR, campos, y dos filas de 2 columnas -->
<mah:MetroWindow x:Class="ejercicio2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ejercicio2"
        mc:Ignorable="d"
        Title="LOGIN" Height="450" Width="800">

    <!-- El color de fondo va en el Grid principal -->
    <Grid Background="#04113e">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: imagen del escudo, Uniform mantiene la proporcion -->
        <Image Grid.Column="0" Source="/Recursos/escudologin5.png"
               Stretch="Uniform" Margin="20"/>

        <!-- COLUMNA DERECHA: formulario. VerticalAlignment Center lo centra y Margin 60,0 da los laterales -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="60,0">

            <!-- Titulo -->
            <TextBlock Text="Welcome Folk" Foreground="White" FontSize="32"
                       HorizontalAlignment="Center"/>

            <!-- Texto pequeno, TextWrapping hace que se ajuste al ancho disponible -->
            <TextBlock Text="Welcome. Please login with your personal account information."
                       Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- Boton con icono y texto: un solo hijo, un StackPanel horizontal que contiene los dos -->
            <Button Background="#1976D2" Foreground="White" Padding="0,8" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/Recursos/googleplus.png" Width="20"/>
                    <TextBlock Text="Sign in with Google" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <!-- Separador OR: Grid de 3 columnas, linea (*), texto (Auto), linea (*) -->
            <Grid Margin="0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="Gray"/>
                <TextBlock Grid.Column="1" Text="OR" Foreground="White" Margin="10,0"/>
                <Border Grid.Column="2" Height="1" Background="Gray"/>
            </Grid>

            <!-- Campos con estilo de Material Design: el hint flota sobre la linea inferior -->
            <TextBox x:Name="txtEmail"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     mat:HintAssist.Hint="Email Address"
                     mat:HintAssist.Foreground="LightGray"
                     Foreground="White" Margin="0,10,0,0"/>

            <PasswordBox x:Name="txtPassword"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         mat:HintAssist.Hint="Password"
                         mat:HintAssist.Foreground="LightGray"
                         Foreground="White" Margin="0,15,0,0"/>

            <!-- Fila de dos elementos: Remember me a la izquierda y Forgot password a la derecha -->
            <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Remember me" Foreground="White"/>
                <Button Grid.Column="1" Content="Forgot password?" HorizontalAlignment="Right"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="#1976D2" FontSize="10" Padding="0"/>
            </Grid>

            <!-- Fila de dos botones: cada uno ocupa la mitad y el Margin los separa -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Get Start" Background="#1976D2"
                        Foreground="White" BorderBrush="Transparent" Margin="0,0,5,0"/>
                <Button Grid.Column="1" Content="Register" Background="Transparent"
                        Foreground="#1976D2" BorderBrush="#1976D2" Margin="5,0,0,0"/>
            </Grid>

        </StackPanel>
    </Grid>
</mah:MetroWindow>
