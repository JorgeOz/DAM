<!-- EJERCICIO 6: VENTANA REDONDEADA. Window transparente, un Border blanco redondeado de fondo y la imagen recortada con OpacityMask -->
<mah:MetroWindow x:Class="ejercicio6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" Height="450" Width="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Fondo blanco redondeado que ocupa las dos columnas -->
        <Border BorderThickness="1" CornerRadius="50" BorderBrush="White" Background="White" Grid.ColumnSpan="2"/>

        <!-- IZQUIERDA: imagen recortada con la forma del Border Mask, capa roja y texto -->
        <Grid>
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Mask}"/>
            </Grid.OpacityMask>
            <Border Name="Mask" Background="White" CornerRadius="50 0 0 50"/>
            <Image Source="/Recursos/Recursos/imagenes/office.jpg" Stretch="UniformToFill"/>
            <Rectangle Fill="#99B71C1C"/>
            <TextBlock Text="Bienvenido" Foreground="White" FontSize="56" FontWeight="Bold"
                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="30,0,20,0"/>
        </Grid>

        <!-- DERECHA: formulario -->
        <StackPanel Grid.Column="1" Margin="60,0,60,0" VerticalAlignment="Center">
            <TextBlock Text="LOGIN" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Inicia sesión en la aplicación" FontSize="11" Foreground="Gray"/>

            <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     mat:HintAssist.Hint="Nombre de Usuario" Margin="0,15,0,0"/>
            <PasswordBox Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         mat:HintAssist.Hint="Password" Margin="0,10,0,0"/>

            <CheckBox Content="Acepto los términos de la Política de Privacidad" IsChecked="True"
                      FontSize="10" Margin="0,15,0,0"/>

            <Button Content="CERRAR SESIÓN" HorizontalAlignment="Right" MinWidth="120" Margin="0,15,0,0"
                    Background="#D32F2F" BorderBrush="#D32F2F" Foreground="White"
                    mat:ButtonAssist.CornerRadius="15" x:Name="btnCerrarSesion" Click="btnCerrarSesion_Click"/>

            <TextBlock Text="Login con redes sociales" FontSize="10" Foreground="Gray" Margin="0,20,0,0"/>

            <!-- Tres botones de igual ancho con icono y texto, un solo hijo cada uno -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="#3B5998" BorderBrush="#3B5998" Foreground="White"
                        mat:ButtonAssist.CornerRadius="15" Margin="0,0,4,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal">
                        <mat:PackIcon Kind="Facebook" VerticalAlignment="Center"/>
                        <TextBlock Text="Facebook" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Background="#1DA1F2" BorderBrush="#1DA1F2" Foreground="White"
                        mat:ButtonAssist.CornerRadius="15" Margin="4,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal">
                        <mat:PackIcon Kind="Twitter" VerticalAlignment="Center"/>
                        <TextBlock Text="Twitter" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Background="#E04932" BorderBrush="#E04932" Foreground="White"
                        mat:ButtonAssist.CornerRadius="15" Margin="4,0,0,0" Padding="4,0">
                    <StackPanel Orientation="Horizontal">
                        <mat:PackIcon Kind="Google" VerticalAlignment="Center"/>
                        <TextBlock Text="Google +" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
