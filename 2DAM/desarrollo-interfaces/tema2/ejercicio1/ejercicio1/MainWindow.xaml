<!-- EJERCICIO 1: DASHBOARD (sin estilos) -->
<!-- PLAN DE LAYOUTS: ventana = Grid de 2 columnas (barra lateral y contenido) -->
<!-- Barra lateral = StackPanel vertical, cada opcion es un StackPanel horizontal (icono y texto) -->
<!-- Contenido = Grid de 4 filas: banner (Auto), metricas (Auto), grafica (*), tarjetas (Auto) -->
<!-- Banner = Grid con fondo rojo, el color va en el Grid para ocupar todo el ancho -->
<!-- Metricas = Grid de 2 columnas, tarjetas = Grid de 3 columnas iguales -->
<Window x:Class="ejercicio1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ejercicio1"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="800"
        ResizeMode="NoResize">

    <!-- NIVEL 1: VENTANA -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Barra lateral: 20% del ancho con un minimo para que no se aplaste -->
            <ColumnDefinition Width="2*" MinWidth="150"/>
            <!-- Contenido: el 80% restante -->
            <ColumnDefinition Width="8*"/>
        </Grid.ColumnDefinitions>

        <!-- NIVEL 2A: BARRA LATERAL -->
        <Grid Grid.Column="0" Background="#222222">
            <StackPanel>
                <!-- Logo y nombre -->
                <Image Source="/Recursos/TV.png" Width="50" Margin="0,15,0,0"/>
                <TextBlock Text="Make Work" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,5,0,15"/>

                <!-- Opciones del menu: icono y texto en horizontal -->
                <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                    <Image Source="/Recursos/LineChart.png" Width="20"/>
                    <TextBlock Text="Stats" Foreground="White" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                    <Image Source="/Recursos/Lock.png" Width="20"/>
                    <TextBlock Text="Safetyboost" Foreground="White" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                    <Image Source="/Recursos/Trash.png" Width="20"/>
                    <TextBlock Text="Trash" Foreground="White" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                    <Image Source="/Recursos/Settings.png" Width="20"/>
                    <TextBlock Text="Adjustments" Foreground="White" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                    <Image Source="/Recursos/Profile.png" Width="20"/>
                    <TextBlock Text="Profile" Foreground="White" Margin="20,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- NIVEL 2B: ZONA DE CONTENIDO -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FILA 0: BANNER. El Background va en el Grid para que el rojo ocupe todo el ancho -->
            <Grid Grid.Row="0" Background="#e8464d">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="Safetyboost" Foreground="White" FontSize="30"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Esto es una prueba del módulo DI del ciclo de DAM"
                               Foreground="White" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="170" Margin="30,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Check it" Background="Transparent" BorderBrush="White"
                            Foreground="White" Padding="10,5" Margin="30,0,0,0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- FILA 1: BARRAS Y CIRCULOS. Dos columnas, las imagenes sustituyen a los componentes graficos -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Some things you should know" FontWeight="Bold"
                               Margin="20,15,0,5"/>
                    <Image Source="/Recursos/lineas.png" Margin="20,0,10,0" Stretch="Uniform"/>
                </StackPanel>

                <Image Grid.Column="1" Source="/Recursos/circulos.gif" Margin="10" Stretch="Uniform"/>
            </Grid>

            <!-- FILA 2: GRAFICA. Fila con altura *, crece o encoge con la ventana -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Performance Development" FontWeight="Bold" Margin="20,15,0,5"/>
                <Image Source="/Recursos/lineChart.jpg" Margin="20,0,20,0" Stretch="Uniform"/>
            </StackPanel>

            <!-- FILA 3: TARJETAS. Tres columnas iguales, cada tarjeta ocupa un tercio sin anchos fijos -->
            <Grid Grid.Row="3" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta 1: naranja -->
                <Border Grid.Column="0" Background="#faaf3a" Margin="0,0,10,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="GET MORE OUT OF IT" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Esto es un ejemplo del ciclo de DAM del IES Henri Matisse"
                                   FontSize="10" TextWrapping="Wrap" Foreground="White"
                                   Margin="0,10,0,10"/>
                        <Button Content="Upgrade" Background="Transparent" BorderBrush="White"
                                Foreground="White" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: azul -->
                <Border Grid.Column="1" Background="#2280b3" Margin="5,0,5,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="NEWSFEED" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Esto es un ejemplo del ciclo de DAM del IES Henri Matisse"
                                   FontSize="10" TextWrapping="Wrap" Foreground="White"
                                   Margin="0,10,0,10"/>
                        <Button Content="Read More" Background="Transparent" BorderBrush="White"
                                Foreground="White" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: azul con titulo e icono, sin boton -->
                <Border Grid.Column="2" Background="#2280b3" Margin="10,0,0,0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="SYSTEM INFORMATION" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <Image Source="/Recursos/linechart80.png" Width="80" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
