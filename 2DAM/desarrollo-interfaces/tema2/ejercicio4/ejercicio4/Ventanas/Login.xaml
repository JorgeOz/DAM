<!-- EJERCICIO 4: LOGIN CON IMAGEN, MetroWindow sin barra de titulo ni botones -->
<!-- PLAN: Grid de 2 columnas, izquierda imagen y derecha formulario en StackPanel -->
<!-- El texto grande cruza a la columna derecha: hijo del Grid principal con ColumnSpan, el ultimo para quedar delante -->
<!-- El formulario lleva un Margin lateral grande para que el texto que cruza termine antes de que empiece -->
<mah:MetroWindow x:Class="ejercicio4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ejercicio4"
        mc:Ignorable="d"
        Title="MAIN WINDOW" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ShowTitleBar="False"
        ShowCloseButton="False"
        ShowMaxRestoreButton="False"
        ShowMinButton="False">

    <Grid Background="#2B2B2B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34*"/>
            <ColumnDefinition Width="66*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: imagen de fondo y el MATISSE de arriba -->
        <Grid Grid.Column="0">
            <Image Source="/Recursos/Recursos/imagenes/portatil.jpg" Stretch="UniformToFill"/>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Recursos/Recursos/iconos/matisse.png" Height="40" VerticalAlignment="Top" Margin="20, 20, 0, 0"/>
                <TextBlock Text="MATISSE" Foreground="White" FontSize="22" FontWeight="Bold"
           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 30, 0, 0"/>
            </StackPanel>
        </Grid>

        <!-- COLUMNA DERECHA: formulario estrecho, Margin 150,0 lo separa del borde de la imagen y de la ventana -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="150,0">

            <TextBlock Text="BIENVENIDO" Foreground="White" FontSize="28" Margin="0,0,0,30"/>

            <!-- Username y Password son TextBlock normales encima de cada campo, no marcas de agua -->
            <TextBlock Text="Username" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Background="#3A3A3A" Foreground="White" BorderThickness="0"
                     Padding="8" Margin="0,0,0,20"/>

            <TextBlock Text="Password" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="passClaveAcceso" Background="#3A3A3A" Foreground="White" BorderThickness="0"
                         Padding="8" Margin="0,0,0,25"/>

            <Button Content="Login" Background="#3355FF" Foreground="White"
                    BorderBrush="Transparent" Padding="0,8" Click="btnLogin_Click"/>

            <Button Content="Forgot Password?" Background="Transparent" BorderBrush="Transparent"
                    Foreground="#2E8BFF" FontWeight="Bold" HorizontalAlignment="Center"
                    Margin="0,10,0,0"/>
        </StackPanel>

        <!-- SIGN UP: misma celda que el formulario pero pegado abajo a la derecha, un solo hijo en el boton -->
        <Button Grid.Column="1" Background="Transparent" BorderBrush="Transparent"
                Foreground="#2E8BFF" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SIGN UP" VerticalAlignment="Center" FontSize="11"/>
                <mat:PackIcon Kind="Account" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- TEXTO QUE CRUZA: ocupa las dos columnas, va el ultimo para pintarse encima, IsHitTestVisible False para no bloquear clics -->
        <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="120,0,0,0" IsHitTestVisible="False">
            <TextBlock Text="Aplicación Inventario" Foreground="White"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="IES Henri Matisse" Foreground="White"
                       FontSize="20" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>