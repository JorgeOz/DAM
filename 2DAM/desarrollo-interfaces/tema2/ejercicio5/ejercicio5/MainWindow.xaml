<!-- EJERCICIO 5: LOGIN, izquierda formulario y derecha imagen con texto. Campos y botones redondos hechos con Border, sin estilos de Material Design -->
<mah:MetroWindow x:Class="ejercicio5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Inventario Matisse" Height="520" Width="860" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: formulario en un StackPanel centrado verticalmente -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="50,0">

            <TextBlock Text="BIENVENIDO A" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="INVENTARIO MATISSE" FontSize="24" Foreground="#D32F2F" HorizontalAlignment="Center"/>
            <Image Source="/Recursos/Recursos/iconos/infinity.png" Height="40" Margin="0,10"/>
            <TextBlock Text="Para entrar en la aplicación introduce tu usuario y contraseña. Puedes realizar el inicio de sesión con tus redes sociales"
                       FontSize="10" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"/>

            <!-- Campo usuario: Border redondeado con icono, TextBox sin borde y un TextBlock de ayuda en la misma celda -->
            <Border CornerRadius="20" BorderBrush="#999999" BorderThickness="1" Margin="0,20,0,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <mat:PackIcon Grid.Column="0" Kind="Account" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtUsuario" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Padding="5,8" VerticalContentAlignment="Center"/>
                    <!-- La ayuda se ve solo si el TextBox esta vacio: un DataTrigger sobre su Text -->
                    <TextBlock Grid.Column="1" Text="Nombre de usuario" Foreground="Gray" FontSize="11"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=txtUsuario}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Campo clave: igual, pero Password no admite binding, la ayuda se oculta con el evento PasswordChanged -->
            <Border CornerRadius="20" BorderBrush="#999999" BorderThickness="1" Margin="0,15,0,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <mat:PackIcon Grid.Column="0" Kind="Lock" Foreground="Gray" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="txtClave" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Padding="5,8" VerticalContentAlignment="Center"
                                 PasswordChanged="txtClave_PasswordChanged"/>
                    <TextBlock x:Name="hintClave" Grid.Column="1" Text="Clave de acceso" Foreground="Gray" FontSize="11"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Boton LOGIN redondeado: Border con el color y un Button transparente dentro -->
            <Border CornerRadius="18" Background="#D32F2F" Margin="0,20,0,0">
                <Button Content="LOGIN" Background="Transparent" BorderThickness="0"
                        Foreground="White" FontWeight="Bold" Padding="0,8"/>
            </Border>

            <!-- Texto con una parte en rojo y negrita -->
            <TextBlock HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="11">
                <Run Text="No tienes cuenta?" Foreground="Gray"/>
                <Run Text="SIGN IN NOW" Foreground="#D32F2F" FontWeight="Bold"/>
            </TextBlock>

            <!-- Separador OR: Grid de 3 columnas, linea, texto, linea -->
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" Background="LightGray"/>
                <TextBlock Grid.Column="1" Text="OR" FontSize="10" Foreground="Gray" Margin="10,0"/>
                <Border Grid.Column="2" Height="1" Background="LightGray"/>
            </Grid>

            <TextBlock Text="Inicia sesión con redes sociales" FontSize="10" Foreground="Gray"
                       HorizontalAlignment="Center"/>

            <!-- Botones circulares: Border con CornerRadius la mitad del tamano, y un Button transparente con el icono -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#BBBBBB" BorderThickness="1" Margin="5">
                    <Button Background="Transparent" BorderThickness="0" Padding="0">
                        <mat:PackIcon Kind="Facebook" Foreground="#333333"/>
                    </Button>
                </Border>
                <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#BBBBBB" BorderThickness="1" Margin="5">
                    <Button Background="Transparent" BorderThickness="0" Padding="0">
                        <mat:PackIcon Kind="Twitter" Foreground="#333333"/>
                    </Button>
                </Border>
                <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#BBBBBB" BorderThickness="1" Margin="5">
                    <Button Background="Transparent" BorderThickness="0" Padding="0">
                        <mat:PackIcon Kind="Google" Foreground="#333333"/>
                    </Button>
                </Border>
                <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#BBBBBB" BorderThickness="1" Margin="5">
                    <Button Background="Transparent" BorderThickness="0" Padding="0">
                        <mat:PackIcon Kind="Instagram" Foreground="#333333"/>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- COLUMNA DERECHA: fondo rojo, imagen, capa semitransparente y texto, todo en la misma celda y en ese orden -->
        <Grid Grid.Column="1" Background="#8E1B1B">
            <Image Source="/Recursos/Recursos/imagenes/Entrada.jpg" Stretch="UniformToFill"/>
            <Rectangle Fill="#AA8B0000"/>
            <StackPanel VerticalAlignment="Center" Margin="30,0">
                <Image Source="/Recursos/Recursos/iconos/matisse.png"  Height="50" HorizontalAlignment="Center"/>
                <TextBlock Text="IES MATISSE" Foreground="White" FontSize="44" HorizontalAlignment="Center"/>
                <TextBlock Text="Con esta aplicación puedes realizar la entrada y salida de material, gestionar los usuarios, manejar el inventario del centro, informes y gráficos."
                           Foreground="White" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>