<Window x:Class="Repaso_Ejercicio1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Repaso_Ejercicio1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="Aqua"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Login" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBox Margin="40,20,40,0"/>
            <PasswordBox Margin="40,20,40,0"/>
            <Button Content="Entrar" Margin="40,20,40,0"
                HorizontalAlignment="Center" Width="150"/>
        </StackPanel>
    </Grid>
</Window>
