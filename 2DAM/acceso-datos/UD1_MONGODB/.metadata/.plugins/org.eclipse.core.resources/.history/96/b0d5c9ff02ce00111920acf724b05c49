package Ejercicios;

import java.io.FileNotFoundException;
import java.io.FileReader;
import java.io.IOException;

import org.json.simple.JSONArray;
import org.json.simple.JSONObject;
import org.json.simple.parser.JSONParser;
import org.json.simple.parser.ParseException;

public class Ejercicio4 {

	public static void main(String[] args) {

		System.out.println("EJ4. Mostrar el nombre y el stock de los productos que están en el <<Almacén 1>> y que su precio es inferior a 150");
		System.out.println("==================================================================================================================");

		JSONParser parser = new JSONParser();
		JSONArray productos = null;
		JSONObject producto = null;
		JSONObject ubicacion = null;
		String v_almacen = "";
		Double v_precio = 0.0;

		try {
			productos = (JSONArray) parser.parse(new FileReader("ficheros/productos.json"));

			for (Object produc : productos) {
				producto = (JSONObject) produc;
				ubicacion = (JSONObject) producto.get("ubicacion");
				v_precio = (Double) producto.get("precio");
				v_almacen = (String) ubicacion.get("almacen");

				if (v_almacen.equals("Almacén 1") && v_precio < 150.0) {
					System.out.println("- Nombre del producto: " + producto.get("nombre_producto") + " || Stock: " + producto.get("stock"));
				}
			}

		} catch (FileNotFoundException e) {
			e.printStackTrace();
		} catch (IOException e) {
			e.printStackTrace();
		} catch (ParseException e) {
			e.printStackTrace();
		}
	}
}