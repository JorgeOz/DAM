package ejemplos;

import java.io.*;
import com.google.gson.Gson;

public class FootballPlayerFrom {

	public static void main(String[] args) {
		
		File archivo = null;
		FileReader reader = null;
		BufferedReader buffer = null;
		String linea, jsonAll = new String();
		
		try {
			
			reader = new FileReader("ficheros/FootballPlay.json");
			buffer = new BufferedReader(reader);
			while ((linea = buffer.readLine()) != null) {
				jsonAll = jsonAll + linea;
			}
			Gson gson = new Gson();
			FootballPlayer[] footballPlayers = gson.fromJson(jsonAll, FootballPlayer[].class);
			
			for (FootballPlayer footballPlayer : footballPlayers) {
				System.out.println("Jugador: " + footballPlayer.toString());
			}
			
		} catch(IOException e) {
			e.printStackTrace();
		}
	}
}
